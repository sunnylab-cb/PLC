python scripts/train_v6m4.py \
    --config configs/pocket_gvp_v6.yaml --amp

# 双GPU + torch.compile
torchrun --nproc_per_node=2 scripts/train_v6m4.py \
    --config configs/pocket_gvp_v6.yaml --compile --amp
```

